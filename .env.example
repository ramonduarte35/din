# ==============================================================================
# 💰 DIN - CONFIGURAÇÃO DE AMBIENTE (.env)
# ==============================================================================

# Portas dos Serviços no Host (Customizáveis para evitar conflitos)
PORT_FRONTEND=8000
PORT_API=3001
PORT_EVOLUTION=4000
POSTGRES_PORT=5434
REDIS_PORT=6381

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=din

# Autenticação JWT
JWT_SECRET=din_super_secret_jwt_key_2026_change_in_production

# OpenAI API (Para IA de linguagem natural)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Evolution API (Gateway WhatsApp)
# Opção A: Usar o container da Evolution que vem junto com o Din (porta 4000)
EVOLUTION_API_URL=http://evolution-go:8080
EVOLUTION_GLOBAL_API_KEY=din_evolution_global_key_2026
EVOLUTION_WEBHOOK_SECRET=din_webhook_secret_2026

# Opção B: Reutilizar um container da Evolution que você JÁ tem no mesmo servidor (ex: na porta 8080)
# EVOLUTION_API_URL=http://host.docker.internal:8080
# EVOLUTION_GLOBAL_API_KEY=sua_global_api_key_do_outro_evolution
