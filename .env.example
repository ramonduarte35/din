# ==========================================
# DIN - SISTEMA INTELIGENTE DE GESTÃO FINANCEIRA
# ==========================================

# Aplicação Backend
PORT=3000
NODE_ENV=development
JWT_SECRET=din_jwt_secret_key_change_me_in_production_2026

# Banco de Dados PostgreSQL (Din App)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=din
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@db:5432/din?schema=public"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL="redis://redis:6379"

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Evolution Go (WhatsApp Gateway)
EVOLUTION_SERVER_PORT=4000
EVOLUTION_GLOBAL_API_KEY=din_evolution_global_key_2026
EVOLUTION_API_URL="http://evolution-go:4000"
EVOLUTION_WEBHOOK_SECRET=din_webhook_secret_2026

# Frontend
VITE_API_URL=http://localhost:3000
