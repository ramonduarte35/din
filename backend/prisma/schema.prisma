generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  PRO
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionOrigin {
  MANUAL
  WHATSAPP_TEXT
  WHATSAPP_AUDIO
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CREDIT_CARD
  CASH
  OTHER
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum WhatsAppLogStatus {
  SUCCESS
  USER_NOT_FOUND
  PRO_REQUIRED
  PARSING_ERROR
}

model User {
  id                String           @id @default(uuid())
  name              String
  email             String           @unique
  password_hash     String?
  phone_number      String?          @unique
  avatar_url        String?
  google_id         String?          @unique
  subscription_tier SubscriptionTier @default(FREE)
  role              Role             @default(USER)
  theme             String           @default("dark")
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  accounts          Account[]
  categories        Category[]
  transactions      Transaction[]
  bills             Bill[]

  @@map("users")
}

model Account {
  id              String      @id @default(uuid())
  user_id         String
  name            String
  type            AccountType @default(CHECKING)
  color           String      @default("#10b981")
  icon            String      @default("Landmark")
  initial_balance Decimal     @default(0) @db.Decimal(12, 2)
  is_default      Boolean     @default(false)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]
  bills        Bill[]

  @@index([user_id])
  @@map("accounts")
}

model SystemWhatsAppNumber {
  id            String   @id @default(uuid())
  instance_name String   @unique
  phone_number  String
  label         String
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  @@map("system_whatsapp_numbers")
}

model Category {
  id         String       @id @default(uuid())
  user_id    String?
  name       String
  type       CategoryType
  icon       String       @default("Tag")
  color      String       @default("#64748b")
  created_at DateTime     @default(now())

  user         User?         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]
  bills        Bill[]

  @@index([user_id])
  @@map("categories")
}

model Transaction {
  id                 String            @id @default(uuid())
  user_id            String
  account_id         String?
  category_id        String?
  description        String
  amount             Decimal           @db.Decimal(12, 2)
  type               TransactionType
  date               DateTime          @default(now())
  origin             TransactionOrigin @default(MANUAL)
  received_on_number String?
  raw_message        String?           @db.Text
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account  Account?  @relation(fields: [account_id], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  bill     Bill?

  @@index([user_id, date])
  @@index([user_id, type])
  @@index([user_id, account_id])
  @@map("transactions")
}

model Bill {
  id             String      @id @default(uuid())
  user_id        String
  category_id    String?
  account_id     String?
  transaction_id String?     @unique
  description    String
  amount         Decimal     @db.Decimal(12, 2)
  due_date       DateTime
  paid_date      DateTime?
  status         BillStatus  @default(PENDING)
  barcode        String?
  notes          String?     @db.Text
  is_recurring   Boolean     @default(false)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [category_id], references: [id], onDelete: SetNull)
  account     Account?     @relation(fields: [account_id], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transaction_id], references: [id], onDelete: SetNull)

  @@index([user_id, due_date])
  @@index([user_id, status])
  @@index([user_id, status, due_date])
  @@map("bills")
}


model WhatsAppLog {
  id                      String            @id @default(uuid())
  sender_number           String
  target_instance         String
  message_body            String            @db.Text
  status                  WhatsAppLogStatus
  openai_response_payload Json?
  created_at              DateTime          @default(now())

  @@index([sender_number])
  @@index([created_at])
  @@map("whatsapp_logs")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("system_settings")
}

