generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentBillingType {
  PIX
  CREDIT_CARD
  BOLETO
  UNDEFINED
}

enum PaymentStatus {
  PENDING
  RECEIVED
  CONFIRMED
  OVERDUE
  REFUNDED
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionOrigin {
  MANUAL
  WHATSAPP_TEXT
  WHATSAPP_AUDIO
  TELEGRAM_TEXT
  TELEGRAM_AUDIO
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CREDIT_CARD
  CASH
  OTHER
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ReceivableStatus {
  PENDING
  RECEIVED
  OVERDUE
  CANCELLED
}

enum ContactType {
  PF
  PJ
}

enum WhatsAppLogStatus {
  SUCCESS
  USER_NOT_FOUND
  PRO_REQUIRED
  PARSING_ERROR
}

enum WhatsAppProviderType {
  EVOLUTION
  META_OFFICIAL
}

model User {
  id                String           @id @default(uuid())
  name              String
  email             String           @unique
  password_hash     String?
  phone_number      String?          @unique
  telegram_id       String?          @unique
  telegram_username String?
  avatar_url        String?
  google_id         String?          @unique
  subscription_tier       SubscriptionTier   @default(FREE)
  subscription_status     SubscriptionStatus @default(ACTIVE)
  subscription_expires_at DateTime?
  asaas_customer_id       String?
  asaas_subscription_id   String?
  role                    Role               @default(USER)
  theme                   String             @default("dark")
  created_at              DateTime           @default(now())
  updated_at              DateTime           @updatedAt

  accounts          Account[]
  categories        Category[]
  transactions      Transaction[]
  bills             Bill[]
  goals             Goal[]
  budgets           Budget[]
  consents          UserConsent[]
  auditLogs         AuditLog[]            @relation("UserAuditLogs")
  actorAuditLogs    AuditLog[]            @relation("ActorAuditLogs")
  contacts          Contact[]
  receivables       Receivable[]
  payments          SubscriptionPayment[]

  @@index([asaas_customer_id])
  @@map("users")
}

model Account {
  id              String      @id @default(uuid())
  user_id         String
  name            String
  type            AccountType @default(CHECKING)
  color           String      @default("#10b981")
  icon            String      @default("Landmark")
  initial_balance Decimal     @default(0) @db.Decimal(12, 2)
  is_default      Boolean     @default(false)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]
  bills        Bill[]
  receivables  Receivable[]

  @@index([user_id])
  @@map("accounts")
}

model SystemWhatsAppNumber {
  id            String   @id @default(uuid())
  instance_name String   @unique
  phone_number  String
  label         String
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  @@map("system_whatsapp_numbers")
}

model Category {
  id         String       @id @default(uuid())
  user_id    String?
  name       String
  type       CategoryType
  icon       String       @default("Tag")
  color      String       @default("#64748b")
  created_at DateTime     @default(now())

  user         User?         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]
  bills        Bill[]
  budgets      Budget[]
  receivables  Receivable[]

  @@index([user_id])
  @@map("categories")
}

model Transaction {
  id                 String            @id @default(uuid())
  user_id            String
  account_id         String?
  category_id        String?
  description        String
  amount             Decimal           @db.Decimal(12, 2)
  type               TransactionType
  date               DateTime          @default(now())
  origin             TransactionOrigin @default(MANUAL)
  received_on_number String?
  raw_message        String?           @db.Text
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account  Account?  @relation(fields: [account_id], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  bill        Bill?
  receivable  Receivable?

  @@index([user_id, date])
  @@index([user_id, type])
  @@index([user_id, account_id])
  @@index([user_id, category_id])
  @@index([user_id, origin])
  @@index([user_id, category_id, date])
  @@index([user_id, description])
  @@map("transactions")
}

model Bill {
  id             String      @id @default(uuid())
  user_id        String
  category_id    String?
  account_id     String?
  transaction_id String?     @unique
  description    String
  amount         Decimal     @db.Decimal(12, 2)
  due_date       DateTime
  paid_date      DateTime?
  status         BillStatus  @default(PENDING)
  barcode            String?
  notes              String?     @db.Text
  is_recurring       Boolean     @default(false)
  installment_number Int?
  total_installments Int?
  group_id           String?
  contact_id         String?
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [category_id], references: [id], onDelete: SetNull)
  account     Account?     @relation(fields: [account_id], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transaction_id], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contact_id], references: [id], onDelete: SetNull)

  @@index([user_id, due_date])
  @@index([user_id, status])
  @@index([user_id, status, due_date])
  @@index([user_id, group_id])
  @@index([user_id, contact_id])
  @@map("bills")
}

model Contact {
  id         String      @id @default(uuid())
  user_id    String
  name       String
  type       ContactType @default(PF)
  document   String?     // CPF (PF) ou CNPJ (PJ)
  email      String?
  phone      String?
  notes      String?     @db.Text
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  bills       Bill[]
  receivables Receivable[]

  @@index([user_id])
  @@index([user_id, type])
  @@map("contacts")
}

model Receivable {
  id                 String           @id @default(uuid())
  user_id            String
  contact_id         String?
  category_id        String?
  account_id         String?
  transaction_id     String?          @unique
  description        String
  amount             Decimal          @db.Decimal(12, 2)
  due_date           DateTime
  received_date      DateTime?
  status             ReceivableStatus @default(PENDING)
  notes              String?          @db.Text
  is_recurring       Boolean          @default(false)
  installment_number Int?
  total_installments Int?
  group_id           String?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  category    Category?    @relation(fields: [category_id], references: [id], onDelete: SetNull)
  account     Account?     @relation(fields: [account_id], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transaction_id], references: [id], onDelete: SetNull)

  @@index([user_id, due_date])
  @@index([user_id, status])
  @@index([user_id, status, due_date])
  @@index([user_id, contact_id])
  @@index([user_id, group_id])
  @@map("receivables")
}

model WhatsAppLog {
  id                      String            @id @default(uuid())
  sender_number           String
  target_instance         String
  message_body            String            @db.Text
  status                  WhatsAppLogStatus
  openai_response_payload Json?
  created_at              DateTime          @default(now())

  @@index([sender_number])
  @@index([created_at])
  @@map("whatsapp_logs")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("system_settings")
}

model WhatsAppIntegrationConfig {
  id                      String               @id @default(uuid())
  active_provider         WhatsAppProviderType @default(EVOLUTION)
  meta_phone_number_id    String?
  meta_waba_id            String?
  meta_access_token       String?              @db.Text
  meta_verify_token       String?
  meta_app_secret         String?
  telegram_bot_token      String?              @db.Text
  telegram_bot_username   String?
  telegram_is_active      Boolean              @default(false)
  telegram_webhook_secret String?
  created_at              DateTime             @default(now())
  updated_at              DateTime             @updatedAt

  @@map("whatsapp_integration_configs")
}

model Goal {
  id             String    @id @default(uuid())
  user_id        String
  title          String
  target_amount  Decimal   @db.Decimal(12, 2)
  current_amount Decimal   @default(0) @db.Decimal(12, 2)
  deadline       DateTime?
  icon           String    @default("Target")
  color          String    @default("#10b981")
  is_completed   Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("goals")
}

model Budget {
  id          String   @id @default(uuid())
  user_id     String
  category_id String
  amount      Decimal  @db.Decimal(12, 2)
  month       Int
  year        Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category_id, month, year])
  @@index([user_id, month, year])
  @@map("budgets")
}

// ─────────────────────────────────────────────────────────
// LGPD — Termos, Consentimentos e Auditoria
// ─────────────────────────────────────────────────────────

/// Versões publicadas dos Termos de Uso / Política de Privacidade.
/// Apenas 1 registro pode ter isActive = true (garantido por unique index no banco).
model Terms {
  id         String   @id @default(uuid())
  version    String   @unique           // ex: "2025.1"
  title      String
  contentUrl String   @map("content_url")
  publishedAt DateTime @default(now()) @map("published_at")
  isActive   Boolean  @default(false)  @map("is_active")
  createdAt  DateTime @default(now())  @map("created_at")

  consents UserConsent[]

  @@map("terms")
}

/// Registro imutável (append-only) de consentimento por usuário.
/// Nunca fazer UPDATE ou DELETE — revogação é feita via novo INSERT com withdrawnAt preenchido.
/// O campo optInTypes é JSONB com chaves: essential (sempre true), analytics, marketing.
model UserConsent {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  termId      String    @map("term_id")
  version     String                      // desnormalizado para auditoria histórica
  ipAddress   String    @map("ip_address")
  userAgent   String    @map("user_agent")
  consentedAt DateTime  @default(now()) @map("consented_at")
  withdrawnAt DateTime? @map("withdrawn_at")  // NULL = ativo; preenchido = revogado
  optInTypes  Json      @default("{\"essential\":true,\"analytics\":false,\"marketing\":false}") @map("opt_in_types")

  user User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  term Terms @relation(fields: [termId], references: [id])

  @@index([userId])
  @@index([consentedAt(sort: Desc)])
  @@map("user_consents")
}

/// Log de auditoria de ações — append-only, nunca pode ser alterado ou excluído.
/// diffPayload contém {before, after} com PII já mascarada (nunca dado real).
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")   // usuário afetado
  actorId     String?  @map("actor_id")  // quem executou a ação
  actorRole   String   @default("USER")  @map("actor_role")  // USER | ADMIN | SYSTEM
  action      String                     // ex: USER_ANONYMIZED, CONSENT_WITHDRAWN
  resource    String                     // ex: users, transactions
  resourceId  String?  @map("resource_id")
  diffPayload Json?    @map("diff_payload")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now())  @map("created_at")

  user  User? @relation("UserAuditLogs",  fields: [userId],  references: [id], onDelete: SetNull)
  actor User? @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([actorId])
  @@index([action])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model SubscriptionPayment {
  id                    String              @id @default(uuid())
  user_id               String
  asaas_payment_id      String              @unique
  asaas_subscription_id String?
  amount                Decimal             @db.Decimal(12, 2)
  net_amount            Decimal?            @db.Decimal(12, 2)
  billing_type          PaymentBillingType  @default(UNDEFINED)
  status                PaymentStatus       @default(PENDING)
  payment_date          DateTime?
  due_date              DateTime?
  client_payment_date   DateTime?
  invoice_url           String?             @db.Text
  bank_slip_url         String?             @db.Text
  pix_qr_code           String?             @db.Text
  pix_copy_paste        String?             @db.Text
  description           String?
  raw_payload           Json?
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@map("subscription_payments")
}

model AffiliateBanner {
  id            String   @id @default(uuid())
  title         String
  description   String?  @db.Text
  image_url     String?  @db.Text
  badge_text    String?
  cta_text      String   @default("Saiba Mais")
  target_url    String   @db.Text
  placement     String   @default("DASHBOARD") // DASHBOARD, TRANSACTIONS, BILLS, GLOBAL
  is_active     Boolean  @default(true)
  views_count   Int      @default(0)
  clicks_count  Int      @default(0)
  display_order Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([is_active, placement])
  @@index([display_order])
  @@map("affiliate_banners")
}

