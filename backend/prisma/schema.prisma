generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  PRO
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionOrigin {
  MANUAL
  WHATSAPP_TEXT
  WHATSAPP_AUDIO
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum WhatsAppLogStatus {
  SUCCESS
  USER_NOT_FOUND
  PRO_REQUIRED
  PARSING_ERROR
}

model User {
  id                String           @id @default(uuid())
  name              String
  email             String           @unique
  password_hash     String
  phone_number      String?          @unique
  subscription_tier SubscriptionTier @default(FREE)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  categories        Category[]
  transactions      Transaction[]

  @@map("users")
}

model SystemWhatsAppNumber {
  id            String   @id @default(uuid())
  instance_name String   @unique
  phone_number  String
  label         String
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  @@map("system_whatsapp_numbers")
}

model Category {
  id         String       @id @default(uuid())
  user_id    String?
  name       String
  type       CategoryType
  icon       String       @default("Tag")
  color      String       @default("#64748b")
  created_at DateTime     @default(now())

  user         User?         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([user_id])
  @@map("categories")
}

model Transaction {
  id                 String            @id @default(uuid())
  user_id            String
  category_id        String?
  description        String
  amount             Decimal           @db.Decimal(12, 2)
  type               TransactionType
  date               DateTime          @default(now())
  origin             TransactionOrigin @default(MANUAL)
  received_on_number String?
  raw_message        String?           @db.Text
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@index([user_id, date])
  @@index([user_id, type])
  @@map("transactions")
}

model WhatsAppLog {
  id                      String            @id @default(uuid())
  sender_number           String
  target_instance         String
  message_body            String            @db.Text
  status                  WhatsAppLogStatus
  openai_response_payload Json?
  created_at              DateTime          @default(now())

  @@index([sender_number])
  @@index([created_at])
  @@map("whatsapp_logs")
}
